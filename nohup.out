        peso float(53),
        proteins float(53),
        proteins_goal float(53),
        tiempo_entrenamiento integer,
        created_at timestamp(6),
        id bigint generated by default as identity,
        updated_at timestamp(6),
        user_name varchar(255),
        primary key (id)
    )
